# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_USER_ID=11111111

# ElevenLabs
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=your_cloned_voice_id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Zernio
ZERNIO_API_KEY=sk_...
ZERNIO_BASE_URL=https://zernio.com/api/v1
ZERNIO_X_ACCOUNT_ID=
ZERNIO_LINKEDIN_ACCOUNT_ID=

# Claude Code CLI (the reasoning layer — swappable). CLAUDE_CODE_COMMAND is the
# command run inside the container; CLAUDE_BIN is the host path that gets mounted
# to /usr/local/bin/claude by docker-compose.yml (override if yours is elsewhere,
# e.g. ~/.local/bin/claude). Bump CLAUDE_TIMEOUT_S on footage-heavy days.
CLAUDE_CODE_COMMAND=claude
CLAUDE_BIN=/usr/local/bin/claude
CLAUDE_CODE_EXTRA_ARGS=
CLAUDE_TIMEOUT_S=600

# Google Drive via rclone (remote:path). Day folders are created under here as
# DRIVE_REMOTE/YYYY-MM-DD/.
DRIVE_REMOTE=gdrive:VideoJournal

# Journal — day numbering counts from TRIP_START_DATE (Day 1 = that date).
TRIP_START_DATE=2026-01-01
TIMEZONE=America/Los_Angeles
PIPELINE_HOUR=22
PIPELINE_MINUTE=30
PUBLISH_HOUR=8
PUBLISH_MINUTE=0
SYNC_INTERVAL_MIN=10

# Verbose stage-by-stage Telegram notifications (set false to only get
# previews, publish confirmations, and errors)
NOTIFY_VERBOSE=true

# false = at 22:30 only send a check-in reminder (clip count + folder link);
# the video build starts when the user sends /makeit
AUTO_PIPELINE=true

# true = after drafting, send the SCRIPT to Telegram for review and wait for
# "✅ Approve & build" before spending time on voiceover + render. Free text
# while reviewing revises the script (no render). false = straight to render.
SCRIPT_REVIEW=true

# Also produce a Spanish voiceover + video + captions every day
BILINGUAL=true

# Read-only web dashboard (Basic auth, any username). Empty password = disabled.
DASHBOARD_PASSWORD=
DASHBOARD_PORT=8080

# Processing
DATA_DIR=/data
WHISPER_MODEL=small
MAX_VIDEO_SECONDS=60
